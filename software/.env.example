# Wi-Fi credentials used by tools/build.sh.
#
# Copy this file to `.env` in the same directory and fill in the values for
# your network. `.env` is ignored by git, so the real credentials are never
# committed.
#
#   cp software/.env.example software/.env
#
# The values are compiled into the firmware image; anyone with physical access
# to the flash can read them back.

# Name of the 2.4 GHz network the sensor joins. The ESP32-S3 has no 5 GHz radio.
WIFI_SSID=my-network

# WPA2 passphrase. Leave empty only for an open network.
WIFI_PASSWORD=my-password
