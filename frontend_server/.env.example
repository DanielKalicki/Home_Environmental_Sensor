# Base URL of the sensor device. The device prints the address it got from DHCP
# at boot as a line starting with "Web server:".
DEVICE_URL=http://192.168.18.2

# How often the poller asks the device for /api/status, in milliseconds.
POLL_INTERVAL_MS=5000

# How long to wait for one device response before giving up, in milliseconds.
REQUEST_TIMEOUT_MS=15000

# Directory the collected readings are written to, relative to this folder.
DATA_DIR=data
